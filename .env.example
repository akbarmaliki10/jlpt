# Set these in Vercel Project Settings -> Environment Variables (never prefix with VITE_)
APP_PASSWORD=change-me-to-a-strong-passphrase
AUTH_SECRET=generate-a-random-32-plus-char-secret
# Automatically provided when you attach a Private Vercel Blob store:
BLOB_READ_WRITE_TOKEN=
# Optional: set to "public" only if you created a Public Blob store instead of Private
# BLOB_ACCESS=private
